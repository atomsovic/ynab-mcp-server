{
  "name": "ynab-mcp-server",
  "version": "0.4.0",
  "description": "MCP server for interacting with a YNAB plan",
  "author": "Caleb LeNoir <caleb.lenoir@hey.com>",
  "contributors": [
    {
      "name": "lwsinclair",
      "url": "https://github.com/lwsinclair"
    },
    {
      "name": "grandcamel",
      "url": "https://github.com/grandcamel"
    },
    {
      "name": "ianthebeard",
      "url": "https://github.com/ianthebeard"
    }
  ],
  "repository": "git+https://github.com/calebl/ynab-mcp-server.git",
  "homepage": "https://github.com/calebl/ynab-mcp-server#readme",
  "bugs": {
    "url": "https://github.com/calebl/ynab-mcp-server/issues"
  },
  "license": "MIT",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ynab",
    "budgeting",
    "personal-finance"
  ],
  "engines": {
    "node": "^22 || >=24"
  },
  "type": "module",
  "bin": {
    "ynab-mcp-server": "./dist/index.js"
  },
  "files": [
    "dist",
    "scripts/patch-oauth-provider.mjs",
    "patches"
  ],
  "scripts": {
    "build": "npm run check:oauth-provider && tsc && chmod +x dist/index.js",
    "prepare": "npm run build",
    "watch": "tsc --watch",
    "start": "node dist/index.js",
    "debug": "npm run build && npx @modelcontextprotocol/inspector dist/index.js",
    "test": "vitest",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "typecheck": "npm run check:oauth-provider && tsc --noEmit && tsc -p tsconfig.worker.json",
    "dev:worker": "npm run check:oauth-provider && wrangler dev",
    "deploy": "npm run check:oauth-provider && wrangler deploy",
    "test:run": "npm run check:oauth-provider && vitest run",
    "test:browser": "npm run check:oauth-provider && YNAB_BROWSER_TESTS=true vitest run src/tests/oauthConsent.browser.test.ts",
    "postinstall": "node scripts/patch-oauth-provider.mjs",
    "check:oauth-provider": "node scripts/patch-oauth-provider.mjs --check"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "0.10.3",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "ynab": "^4.5.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260906.1",
    "@modelcontextprotocol/inspector": "0.16.8",
    "@types/node": "^22.20.3",
    "@vitest/coverage-v8": "^4.1.11",
    "esbuild": "0.28.2",
    "miniflare": "5.20261001.0-alpha",
    "typescript": "^5.3.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.129.0"
  }
}
