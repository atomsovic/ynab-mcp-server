{
  "build": { "command": "npm run check:oauth-provider" },
  "$schema": "node_modules/wrangler/config-schema.json",
  // Nonsecret account resource identifiers supplied by the operator.
  // This file prepares a deployment; committing it does not deploy anything.
  "name": "ynab-mcp-server",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  // Avoid automatic request logging of callback codes/state. Do not log tokens.
  "observability": { "enabled": false },
  "kv_namespaces": [
    { "binding": "OAUTH_KV", "id": "44062199539d467695b9db319996689d" }
  ],
  "r2_buckets": [
    { "binding": "CATEGORY_AUDIT", "bucket_name": "ynab-category-audit" }
  ],
  "durable_objects": {
    "bindings": [{ "name": "OAUTH_FLOWS", "class_name": "OAuthFlowStore" }, { "name": "OAUTH_GRANTS", "class_name": "OAuthGrantStore" }]
  },
  "migrations": [{ "tag": "v1-oauth-flows", "new_sqlite_classes": ["OAuthFlowStore"] }, { "tag": "v2-oauth-grants", "new_sqlite_classes": ["OAuthGrantStore"] }],
  // Preserve additional dashboard runtime variables on later Wrangler deploys.
  "keep_vars": true,
  "vars": {
    "PUBLIC_ORIGIN": "https://ynab-mcp-server.atomsovic2.workers.dev",
    "YNAB_TOOL_MODE": "category-only"
  }
  // Required dashboard runtime vars: YNAB_ALLOWED_PLAN_ID, ALLOWED_GITHUB_LOGIN,
  // GITHUB_CLIENT_ID, OAUTH_ALLOWED_REDIRECT_URIS (JSON array of exact HTTPS URLs).
  // Required dashboard runtime secrets: YNAB_API_TOKEN, GITHUB_CLIENT_SECRET.
  // Optional YNAB_READ_ONLY=true overrides all writes; optional
  // OAUTH_ALLOWED_CLIENT_IDS is a JSON array for pinning already registered IDs.
  // No reminder cron or third-party AI access is enabled by this config.
}
